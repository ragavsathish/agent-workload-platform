{
  "arch": "x86_64",
  "distro": "alpine",
  "env": {
    "NODE_ENV": "production",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
  },
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "initramfsPackages": [
      "linux-virt"
    ],
    "krunfwVersion": "v5.2.1"
  },
  "oci": {
    "image": "c4-gondolin-browser:playwright-mcp-0.0.79-amd64",
    "runtime": "docker",
    "platform": "linux/amd64",
    "pullPolicy": "never"
  },
  "rootfs": {
    "label": "mermaid-layout"
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  }
}
