# syntax=docker/dockerfile:1.7

# Reusable development VM rootfs: tools only, never a checkout or built app.
ARG FLUTTER_TOOLCHAIN_IMAGE=docker.io/plugfox/flutter:3.47.7-web@sha256:bdff6627c0421b1c05f830d60e2792e5930da222318de1c70ffbae954b88c491
ARG VOICE_RUNTIME_IMAGE=gitea.local:3001/image-builder/base-playwright-mcp:v0.0.79-arm64@sha256:2f69a7a48fb9e5eea360f8f160192b11241e6e7d124389c103164f39e6fd2f8d
FROM ${FLUTTER_TOOLCHAIN_IMAGE} AS flutter-toolchain
FROM ${VOICE_RUNTIME_IMAGE}

# Match products/voice-agent/apps/client/package-lock.json. Keep the base
# image's browser for its bundled Playwright MCP tooling.
ARG CLIENT_PLAYWRIGHT_VERSION=1.58.2
ARG BABASHKA_VERSION=1.13.219

USER root
COPY --from=flutter-toolchain /opt/flutter /opt/flutter
COPY --from=flutter-toolchain /var/cache/pub /var/cache/pub
COPY start-dev-docker.sh /usr/local/bin/start-dev-docker
COPY dev-compose /usr/local/bin/dev-compose
COPY select-compose-images.clj /usr/local/libexec/select-compose-images.clj

ENV FLUTTER_HOME=/opt/flutter \
    FLUTTER_ROOT=/opt/flutter \
    PUB_CACHE=/var/cache/pub \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PATH=/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=secret,id=gondolin_mitm_ca,required=false \
    apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates curl docker.io git iproute2 kmod libglu1-mesa unzip xz-utils zip \
    && chmod 0555 /usr/local/bin/start-dev-docker /usr/local/bin/dev-compose \
    && cp /etc/ssl/certs/ca-certificates.crt /tmp/build-ca-bundle.crt \
    && if [ -f /run/secrets/gondolin_mitm_ca ]; then \
         cat /run/secrets/gondolin_mitm_ca >> /tmp/build-ca-bundle.crt; \
       fi \
    && NODE_EXTRA_CA_CERTS=/tmp/build-ca-bundle.crt npm install --global pnpm@11.19.0 "playwright@${CLIENT_PLAYWRIGHT_VERSION}" \
    && NODE_EXTRA_CA_CERTS=/tmp/build-ca-bundle.crt playwright install chromium \
    && npm cache clean --force \
    && case "$(dpkg --print-architecture)" in \
         arm64) bb_arch=aarch64; bb_sha=e8d7a9c66c364b80627a43cb6ba5c14fb6ac7e4af114e8e5d80f97551ccdfe11 ;; \
         amd64) bb_arch=amd64; bb_sha=9ac1fe988d7001625b30ef3e3307e67f8545505a7cb49a4aa179f578115a3e09 ;; \
         *) exit 1 ;; \
       esac \
    && curl --cacert /tmp/build-ca-bundle.crt --fail --location --silent --show-error \
         "https://github.com/babashka/babashka/releases/download/v${BABASHKA_VERSION}/babashka-${BABASHKA_VERSION}-linux-${bb_arch}-static.tar.gz" \
         --output /tmp/babashka.tar.gz \
    && echo "${bb_sha}  /tmp/babashka.tar.gz" | sha256sum --check \
    && tar -xzf /tmp/babashka.tar.gz -C /usr/local/bin bb \
    && chmod 0555 /usr/local/bin/bb \
    && rm /tmp/babashka.tar.gz \
    && case "$(dpkg --print-architecture)" in \
         arm64) compose_arch=aarch64; compose_sha=733ec76717ceb59052a9609b9dadfb523b2df8eab57a54212872d10a58078ea2 ;; \
         amd64) compose_arch=x86_64; compose_sha=40343e21ca777173e69cff5dbafeb37c6f81f3b0d57d9e597f036e95eb63e76a ;; \
         *) exit 1 ;; \
       esac \
    && mkdir -p /usr/local/libexec/docker/cli-plugins \
    && curl --cacert /tmp/build-ca-bundle.crt --fail --location --silent --show-error \
         "https://github.com/docker/compose/releases/download/v5.6.0/docker-compose-linux-${compose_arch}" \
         --output /usr/local/libexec/docker/cli-plugins/docker-compose \
    && echo "${compose_sha}  /usr/local/libexec/docker/cli-plugins/docker-compose" | sha256sum --check \
    && chmod 0555 /usr/local/libexec/docker/cli-plugins/docker-compose \
    && rm /tmp/build-ca-bundle.crt \
    && git config --system --add safe.directory /workspace \
    && docker compose version

ARG MERMAID_CLI_VERSION=11.12.0

COPY mmdc /usr/local/bin/mmdc
COPY puppeteer-config.json /etc/mermaid-cli/puppeteer.json

RUN --mount=type=secret,id=gondolin_mitm_ca,required=false \
    set -eu; \
    cp /etc/ssl/certs/ca-certificates.crt /tmp/build-ca-bundle.crt; \
    if [ -f /run/secrets/gondolin_mitm_ca ]; then \
      cat /run/secrets/gondolin_mitm_ca >> /tmp/build-ca-bundle.crt; \
    fi; \
    PUPPETEER_SKIP_DOWNLOAD=true NODE_EXTRA_CA_CERTS=/tmp/build-ca-bundle.crt \
      npm install --prefix /opt/mermaid-cli --no-audit --no-fund \
      "@mermaid-js/mermaid-cli@${MERMAID_CLI_VERSION}"; \
    browser="$(find /ms-playwright -path '*/chromium-*/chrome-linux/chrome' -type f | sort -V | tail -1)"; \
    test -n "$browser"; \
    ln -s "$browser" /usr/local/bin/playwright-chromium; \
    chmod 0555 /usr/local/bin/mmdc; \
    mmdc --version; \
    printf 'flowchart LR\nA-->B\n' >/tmp/mermaid-smoke.mmd; \
    mmdc --input /tmp/mermaid-smoke.mmd --output /tmp/mermaid-smoke.png; \
    test -s /tmp/mermaid-smoke.png; \
    rm /tmp/mermaid-smoke.mmd /tmp/mermaid-smoke.png /tmp/build-ca-bundle.crt; \
    npm cache clean --force

ARG EXCALIDRAW_MCP_REVISION=157aa23ceb1976008aadc89eb05e3444060f09d6
ARG MERMAID_TO_EXCALIDRAW_REVISION=7849b487be67cf2d439c713c847839d2494d59b6

RUN --mount=type=secret,id=gondolin_mitm_ca,required=false \
    set -eu; \
    cp /etc/ssl/certs/ca-certificates.crt /tmp/build-ca-bundle.crt; \
    if [ -f /run/secrets/gondolin_mitm_ca ]; then \
      cat /run/secrets/gondolin_mitm_ca >> /tmp/build-ca-bundle.crt; \
    fi; \
    mkdir -p /opt/vendor; \
    for source in \
      "excalidraw-mcp|https://github.com/excalidraw/excalidraw-mcp.git|${EXCALIDRAW_MCP_REVISION}" \
      "mermaid-to-excalidraw|https://github.com/excalidraw/mermaid-to-excalidraw.git|${MERMAID_TO_EXCALIDRAW_REVISION}"; do \
      name="${source%%|*}"; remainder="${source#*|}"; \
      url="${remainder%%|*}"; revision="${remainder#*|}"; \
      git init --quiet "/opt/vendor/$name"; \
      git -C "/opt/vendor/$name" remote add origin "$url"; \
      GIT_SSL_CAINFO=/tmp/build-ca-bundle.crt git -C "/opt/vendor/$name" fetch --quiet --depth 1 origin "$revision"; \
      git -C "/opt/vendor/$name" checkout --quiet --detach FETCH_HEAD; \
      test "$(git -C "/opt/vendor/$name" rev-parse HEAD)" = "$revision"; \
      rm -rf "/opt/vendor/$name/.git"; \
    done; \
    (cd /opt/vendor/excalidraw-mcp \
      && NODE_EXTRA_CA_CERTS=/tmp/build-ca-bundle.crt pnpm install --frozen-lockfile --ignore-scripts); \
    test -x /opt/vendor/excalidraw-mcp/node_modules/.bin/vite; \
    rm /tmp/build-ca-bundle.crt; \
    pnpm store prune

WORKDIR /workspace
