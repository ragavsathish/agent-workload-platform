# syntax=docker/dockerfile:1.7

ARG PLAYWRIGHT_MCP_IMAGE=gitea.local:3001/image-builder/base-playwright-mcp:v0.0.79-arm64@sha256:2f69a7a48fb9e5eea360f8f160192b11241e6e7d124389c103164f39e6fd2f8d
FROM prom/prometheus:v3.13.2@sha256:508729e0e2d18e11fd742a5a5ca70e557b940a93948c3c95fd0123a6fd538b69 AS prometheus
FROM ${PLAYWRIGHT_MCP_IMAGE}

ARG TARGETARCH
ARG TEA_VERSION=0.15.1
USER root
COPY --from=prometheus /bin/promtool /usr/local/bin/promtool
COPY --chmod=0555 products/voice-agent/apps/pi-agent/cli/oxigraph /opt/awp/bin/oxigraph
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
    && apt-get install --yes --no-install-recommends awscli ca-certificates curl git
RUN --mount=type=secret,id=gondolin_mitm_ca,required=false \
    cp /etc/ssl/certs/ca-certificates.crt /tmp/build-ca-bundle.crt \
    && if [ -f /run/secrets/gondolin_mitm_ca ]; then \
         cat /run/secrets/gondolin_mitm_ca >> /tmp/build-ca-bundle.crt; \
       fi \
    && case "$TARGETARCH" in \
         amd64) tea_sha256=aac99cc6e650a81ae7b5061f8c75bc0eade4509c828d97b6072e1f0a3bd24357 ;; \
         arm64) tea_sha256=0db109df6696bfe01f9203402f503404692404d4ea9c16a540ecaeecc8e6bab2 ;; \
         *) echo "Unsupported Tea architecture: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && curl --cacert /tmp/build-ca-bundle.crt --fail --location --silent --show-error \
       "https://dl.gitea.com/tea/${TEA_VERSION}/tea-${TEA_VERSION}-linux-${TARGETARCH}" \
       --output /tmp/tea \
    && echo "$tea_sha256  /tmp/tea" | sha256sum --check --strict \
    && install -m 0555 /tmp/tea /usr/local/bin/tea \
    && rm /tmp/tea /tmp/build-ca-bundle.crt \
    && promtool --version
RUN mkdir -p /workspace /output \
    && chown node:node /workspace /output \
    && git config --system --add safe.directory /workspace
USER node
