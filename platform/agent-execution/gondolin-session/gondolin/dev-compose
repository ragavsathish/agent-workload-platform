#!/bin/sh
set -eu

preload=/image-cache
image_store=/image-store/agent/images
if [ -z "${COMPOSE_FILE:-}" ]; then
  echo "Set COMPOSE_FILE to the worktree's Compose file(s) before using dev-compose." >&2
  exit 1
fi
if [ ! -r "$preload/index.json" ] || [ ! -r "$preload/compose.override.json" ]; then
  echo "Shared Compose image cache is not mounted; set GONDOLIN_DEV_IMAGE_CACHE for this Pi session." >&2
  exit 1
fi
if [ ! -d "$image_store" ]; then
  echo "Shared image store is not mounted; set GONDOLIN_DEV_IMAGE_STORE for this Pi session." >&2
  exit 1
fi

if [ "${1:-}" != config ]; then
  if [ -z "${COMPOSE_CACHE_SERVICES:-}" ]; then
    echo "Set COMPOSE_CACHE_SERVICES to the service images needed for this command." >&2
    exit 1
  fi
  archives=$(bb /usr/local/libexec/select-compose-images.clj \
    "$preload/index.json" "$COMPOSE_CACHE_SERVICES")
  printf '%s\n' "$archives" | while IFS="$(printf '\t')" read -r archive checksum; do
    archive_path="$image_store/$archive"
    marker="/var/lib/docker/.gondolin-preload-${archive%.tar.zst}"
    if [ ! -e "$marker" ]; then
      printf '%s  %s\n' "$checksum" "$archive_path" | sha256sum --check --status || {
        echo "Image preload checksum mismatch: $archive" >&2
        exit 1
      }
      zstd --quiet --decompress --stdout "$archive_path" | docker load
      touch "$marker"
    fi
  done
fi

export COMPOSE_FILE="$COMPOSE_FILE:$preload/compose.override.json"
exec docker compose "$@"
