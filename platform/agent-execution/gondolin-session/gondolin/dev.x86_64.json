{
  "arch": "x86_64",
  "distro": "alpine",
  "env": {
    "NODE_ENV": "development",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
  },
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "initramfsPackages": ["linux-virt"],
    "krunfwVersion": "v5.2.1"
  },
  "oci": {
    "image": "voice-agent-gondolin:dev-amd64",
    "runtime": "docker",
    "platform": "linux/amd64",
    "pullPolicy": "never"
  },
  "rootfs": {
    "label": "voice-dev-toolchain",
    "sizeMb": 8192
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  }
}
