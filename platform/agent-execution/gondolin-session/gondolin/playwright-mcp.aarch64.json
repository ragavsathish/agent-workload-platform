{
  "arch": "aarch64",
  "distro": "alpine",
  "env": {
    "NODE_ENV": "production",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
  },
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "initramfsPackages": ["linux-virt"],
    "krunfwVersion": "v5.2.1"
  },
  "oci": {
    "image": "voice-agent-gondolin:playwright-mcp-0.0.79-arm64",
    "runtime": "docker",
    "platform": "linux/arm64",
    "pullPolicy": "never"
  },
  "rootfs": {
    "label": "playwright-mcp"
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  }
}
