{
  "arch": "x86_64",
  "distro": "alpine",
  "env": {
    "NODE_ENV": "production",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
  },
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "initramfsPackages": ["linux-virt"],
    "krunfwVersion": "v5.2.1"
  },
  "oci": {
    "image": "mcr.microsoft.com/playwright/mcp:v0.0.79@sha256:add8756264bc95962597d2e5095b66317acb1d89a7c8b64f264e7d2dee140bc9",
    "runtime": "docker",
    "platform": "linux/amd64",
    "pullPolicy": "if-not-present"
  },
  "rootfs": {
    "label": "playwright-mcp"
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  }
}
