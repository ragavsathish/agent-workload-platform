FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod docker_job_api.go ./
RUN CGO_ENABLED=0 go build -o /out/docker-job-api .

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
COPY --from=build /out/docker-job-api /usr/local/bin/docker-job-api
EXPOSE 18081
ENTRYPOINT ["/usr/local/bin/docker-job-api"]
