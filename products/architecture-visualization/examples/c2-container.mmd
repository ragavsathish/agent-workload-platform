C4Container
title Agent Workload Platform - Container View

Person(author, "Diagram Author", "Requests, reviews, and edits architecture diagrams")

System_Boundary(platform, "Agent Workload Platform") {
  Container(pi, "Pi Coordinator", "Pi extension, TypeScript", "Applies C4 guidance and coordinates compilation, isolation, policy, and presentation")
  Container(wassette, "Wassette Runtime", "WebAssembly component runtime", "Executes capability-limited WIT components")
  Container(suite, "C4 Wasm Suite", "c4-suite.wasm", "Packages the single-runtime C4 engine with reusable policy and checkpoint blocks")
  Container(gondolin, "Gondolin Browser Runtime", "Pi extension and QEMU micro-VM", "Exposes official Playwright MCP tools from an isolated browser")
  Container(webapp, "Excalidraw MCP App", "React browser application", "Displays and edits approved Excalidraw scenes")
  ContainerDb(memory, "Checkpoint Memory", "Pi process memory", "Stores approved scene revisions for the active session")
}

System_Ext(model, "AI Model Provider", "Produces native Mermaid C4 from natural-language requests")

Rel(author, pi, "Requests a C4 diagram", "Natural language or Mermaid")
Rel(pi, model, "Generates Mermaid C4 with", "Model API")
Rel(pi, suite, "Compiles, approves, and checkpoints", "MCP and WIT")
Rel(suite, wassette, "Runs inside", "WebAssembly component")
Rel(pi, gondolin, "May request isolated browser layout", "Playwright MCP; explicit fallback")
Rel(pi, memory, "Stores and restores checkpoints", "In-process calls")
Rel(pi, webapp, "Serves approved scene", "Loopback HTTP")
Rel(webapp, pi, "Saves edits", "Loopback HTTP")
Rel(author, webapp, "Views and edits diagram", "Browser UI")
