C4Deployment
  title Deterministic C4 Compiler - Deployment View

  Person(author, "Diagram Author", "Requests, views, and edits a C4 architecture diagram")

  Deployment_Node(client, "Client Machine", "User workstation", "Orchestrates compilation and presents the approved result") {
    Container(pi, "Pi Coordinator", "Process", "Applies the C4 skill and coordinates the two-phase compiler workflow")

    Deployment_Node(wassette, "Wassette Runtime", "WebAssembly component runtime", "Runs capability-limited WIT components") {
      Container(compiler, "C4 Compiler", "c4-compiler.wasm", "Prepares browser work, consumes typed geometry, and emits Excalidraw JSON")
      Container(policy, "Excalidraw Policy", "excalidraw-policy.wasm", "Admits safe, bounded Excalidraw scenes")
    }

    Container(excalidraw, "Excalidraw Web App", "Browser application", "Displays and edits the approved scene")
    ContainerDb(checkpoints, "Checkpoint Store", "Host memory or LeoFS", "Stores approved Excalidraw scene revisions")
  }

  Deployment_Node(vm, "Gondolin QEMU Micro-VM", "Pinned Playwright MCP OCI root filesystem", "Isolates browser-dependent layout") {
    Container(playwright_mcp, "Playwright MCP Server", "Official @playwright/mcp", "Exposes upstream browser tools over stdio")
    Container(converter, "C4 Converter Sidecar", "Node.js and Mermaid", "Returns a typed layout snapshot")
    Container(chromium, "Chromium", "Headless browser process", "Executes the converter page")
  }

  Rel(author, pi, "Requests a C4 diagram", "Natural language or Mermaid C4")
  Rel(pi, compiler, "Prepares and finishes compilation", "WIT calls")
  Rel(pi, playwright_mcp, "Navigates to C4 converter", "MCP browser_navigate over Gondolin stdio")
  Rel(playwright_mcp, chromium, "Automates", "Chrome DevTools Protocol")
  Rel(chromium, converter, "Loads source and submits geometry", "Loopback HTTP")
  Rel(converter, pi, "Returns computed geometry", "Typed layout-snapshot JSON through mounted result")
  Rel(pi, policy, "Submits candidate scene", "Excalidraw scene-envelope")
  Rel(policy, checkpoints, "Stores approved revision", "Excalidraw JSON")
  Rel(policy, excalidraw, "Supplies approved scene", "Excalidraw JSON")
  Rel(author, excalidraw, "Views and edits diagram", "Browser UI")
