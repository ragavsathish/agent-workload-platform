# syntax=docker/dockerfile:1.7

FROM mcr.microsoft.com/playwright:v1.58.2-noble@sha256:6446946a1d9fd62d9ae501312a2d76a43ee688542b21622056a372959b65d63d AS deps

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    CI=true
WORKDIR /app

# Keep this layer independent from source changes so dependency installation is
# reused unless a manifest or lockfile changes.
COPY package.json pnpm-lock.yaml ./
COPY vendor/mermaid-to-excalidraw/package.json vendor/mermaid-to-excalidraw/package.json
COPY products/architecture-visualization/integrations/gondolin/package.json products/architecture-visualization/integrations/gondolin/package.json
COPY pnpm-workspace.yaml ./
RUN --mount=type=cache,id=c4-pnpm-store,target=/root/.local/share/pnpm/store \
    corepack enable \
  && corepack prepare pnpm@11.19.0 --activate \
  && pnpm install --frozen-lockfile --ignore-scripts --filter @agent-workload-platform/c4-gondolin...

FROM deps AS build

COPY vendor/mermaid-to-excalidraw vendor/mermaid-to-excalidraw
RUN pnpm --dir vendor/mermaid-to-excalidraw run build

COPY products/architecture-visualization/integrations/gondolin products/architecture-visualization/integrations/gondolin
RUN pnpm --dir products/architecture-visualization/integrations/gondolin run bundle

FROM mcr.microsoft.com/playwright/mcp:v0.0.79@sha256:18c0a9c934004fe9580cc79f1e8e6e6cde7c667348b215335e8a23fd3e509804 AS runtime

ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app

COPY --from=build /app/products/architecture-visualization/integrations/gondolin/dist/browser ./products/architecture-visualization/integrations/gondolin/dist/browser
COPY --from=build /app/products/architecture-visualization/integrations/gondolin/scripts/converter-server.mjs ./products/architecture-visualization/integrations/gondolin/scripts/converter-server.mjs

ENTRYPOINT ["node", "/app/cli.js", "--headless", "--browser", "chromium", "--no-sandbox"]
