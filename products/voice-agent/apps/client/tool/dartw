#!/usr/bin/env bash
set -euo pipefail

tool_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
flutter_version="3.47.7"
sdk_dir="$tool_dir/.flutter_tooling/flutter-$flutter_version"

if [[ -n "${DART_BIN:-}" ]]; then
  exec "$DART_BIN" "$@"
fi
if command -v dart >/dev/null 2>&1; then
  exec dart "$@"
fi
if [[ ! -x "$sdk_dir/bin/dart" ]]; then
  "$tool_dir/tool/flutterw" --version >/dev/null
fi
exec "$sdk_dir/bin/dart" "$@"
