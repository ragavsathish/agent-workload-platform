#!/usr/bin/env bash
set -euo pipefail

tool_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pub_cache="${PUB_CACHE:-$tool_dir/.flutter_tooling/pub-cache}"
patrol="$pub_cache/bin/patrol"
patrol_cli_version="4.8.0"
runner="$pub_cache/hosted/pub.dev/patrol-4.10.0/web_runner/tests/test.spec.ts"

installed_version=""
if [[ -x "$patrol" ]]; then
  installed_version="$("$patrol" --version 2>/dev/null || true)"
fi
if [[ ! -x "$patrol" ]] || \
  ! grep -Fq "$pub_cache" "$patrol" || \
  [[ "$installed_version" != *"$patrol_cli_version"* ]]; then
  PUB_CACHE="$pub_cache" "$tool_dir/tool/flutterw" pub global activate \
    patrol_cli "$patrol_cli_version" --overwrite
fi
export PUB_CACHE="$pub_cache"
export PATROL_FLUTTER_COMMAND="$tool_dir/tool/flutterw"
if [[ ! -f "$runner" ]]; then
  "$tool_dir/tool/flutterw" pub get
fi
node "$tool_dir/tool/patch-patrol-web-trace.mjs" "$runner"
if [[ -n "${FLUTTER_BIN:-}" ]]; then
  export PATH="$(dirname "$FLUTTER_BIN"):$PATH"
elif command -v flutter >/dev/null 2>&1; then
  export PATH="$(dirname "$(command -v flutter)"):$PATH"
else
  export PATH="$tool_dir/.flutter_tooling/flutter-3.47.7/bin:$PATH"
fi
exec "$patrol" "$@"
