FROM ghcr.io/astral-sh/uv@sha256:88bc6eb1ccd4b82efd0e1b530caffabddf50dc2bf612e66c14ea25b8ee8a4d3d AS uv
FROM docker.io/library/python@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

LABEL io.pipecat.edge="true"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    HOME=/tmp \
    HF_HUB_OFFLINE=1 \
    XDG_CACHE_HOME=/tmp/cache \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=uv /uv /usr/local/bin/uv
RUN groupadd --gid 65532 app && useradd --uid 65532 --gid 65532 --no-create-home app
RUN install -d -o app -g app -m 0700 /var/lib/voice-diagnostics

WORKDIR /app
COPY apps/edge/pyproject.toml apps/edge/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY apps/edge/fetch_voxlock_model.py ./
COPY apps/edge/instrument_voxlock_model.py ./
RUN /app/.venv/bin/python fetch_voxlock_model.py /app/models/voxlock \
    && UV_CACHE_DIR=/tmp/voxlock-instrument-cache uv run --with onnx --no-project python instrument_voxlock_model.py /app/models/voxlock/chunk_int8.onnx \
    && /app/.venv/bin/python -c 'from voxlock import VoxLock; VoxLock("/app/models/voxlock", precision="int8", threads=2)' \
    && uv cache clean --cache-dir /tmp/voxlock-instrument-cache \
    && chmod -R a-w /app/models/voxlock
COPY apps/edge/bot.py ./
COPY apps/edge/SYSTEM.md ./
COPY apps/edge/audio_filter.py ./
COPY apps/edge/audio_diagnostics.py ./
COPY apps/edge/diagnostic_vad.py ./
COPY apps/edge/otel_bridge.py ./
COPY apps/edge/grafana_mcp.py ./
COPY apps/edge/presentation_response.py ./
COPY packages/telemetry/src ./src
COPY apps/client/build/web ./client-dist
COPY apps/diagnostics/dist ./client-dist/diagnostics
COPY apps/knowledge-base/dist ./client-dist/knowledge

USER 65532:65532
EXPOSE 7860
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=6 \
    CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7860/api/features', timeout=3).read()"]
ENTRYPOINT ["/app/.venv/bin/python", "bot.py"]
CMD ["-t", "webrtc", "--host", "127.0.0.1", "--port", "7860"]
