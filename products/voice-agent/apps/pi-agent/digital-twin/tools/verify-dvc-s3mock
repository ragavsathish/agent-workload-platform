#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
project_dir="$(cd "$script_dir/.." && pwd)"
fixture="$project_dir/artifacts/fixture.txt"
pointer="$project_dir/artifacts.dvc"

if [[ ! -f "$fixture" || ! -f "$pointer" ]]; then
  echo "Run 'make digital-twin-artifact-add' before verification." >&2
  exit 1
fi

temp_dir="$(mktemp -d)"
trap 'rm -rf -- "$temp_dir"' EXIT

git -C "$temp_dir" init --quiet
mkdir -p "$temp_dir/.dvc"
cp "$project_dir/.dvc/config" "$temp_dir/.dvc/config"
cp "$project_dir/.dvcignore" "$temp_dir/.dvcignore"
cp "$pointer" "$temp_dir/artifacts.dvc"

export AWS_ACCESS_KEY_ID="${ARTIFACT_ACCESS_KEY:-local-test}"
export AWS_SECRET_ACCESS_KEY="${ARTIFACT_SECRET_KEY:-local-test}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"
export AWS_S3_ADDRESSING_STYLE=path

uvx --from check-jsonschema==0.38.2 check-jsonschema \
  --schemafile "$project_dir/artifact-bundle.schema.json" \
  "$project_dir/artifacts/manifest.json"
python3 "$project_dir/tools/validate-artifact-bundle.py" "$project_dir/artifacts"
uvx --from dvc==3.67.1 --with dvc-s3==3.3.0 dvc --cd "$project_dir" push artifacts.dvc
uvx --from dvc==3.67.1 --with dvc-s3==3.3.0 dvc --cd "$temp_dir" pull artifacts.dvc
cmp "$fixture" "$temp_dir/artifacts/fixture.txt"

echo "DVC push/pull round trip through S3Mock succeeded."
