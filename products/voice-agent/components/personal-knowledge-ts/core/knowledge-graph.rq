PREFIX schema: <https://schema.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pk: <urn:voice-agent:personal-knowledge:ontology#>
PREFIX oa: <http://www.w3.org/ns/oa#>

SELECT ?from ?fromKind ?fromLabel ?fromEntryId ?to ?toKind ?toLabel ?relation WHERE {
  {
  GRAPH <urn:pk:digital-twin:graph:journal> {
    {
      ?from a schema:CreativeWork ;
        <urn:pk:digital-twin:predicate:recordKind> "codex_daily_journal" ;
        schema:hasPart ?to .
      BIND("contains" AS ?relation)
      BIND("daily_journal" AS ?fromKind)
      BIND("journal_record" AS ?toKind)
    } UNION {
      ?from a pk:DailyJournal ;
        schema:hasPart ?to .
      BIND("contains" AS ?relation)
      BIND("daily_journal" AS ?fromKind)
      BIND("journal_record" AS ?toKind)
    } UNION {
      ?from a pk:DailyJournal ;
        prov:wasDerivedFrom ?to .
      BIND("derived from" AS ?relation)
      BIND("daily_journal" AS ?fromKind)
      BIND("codex_session" AS ?toKind)
    } UNION {
      ?page schema:hasPart ?from .
      ?from prov:wasDerivedFrom ?to .
      ?page <urn:pk:digital-twin:predicate:recordKind> "codex_daily_journal" .
      BIND("derived from" AS ?relation)
      BIND("journal_record" AS ?fromKind)
      BIND("codex_session" AS ?toKind)
    } UNION {
      ?from a schema:CreativeWork ;
        <urn:pk:digital-twin:predicate:recordKind> "codex_daily_journal" ;
        prov:wasGeneratedBy ?to .
      BIND("created by" AS ?relation)
      BIND("daily_journal" AS ?fromKind)
      BIND("pi_durable_task" AS ?toKind)
    } UNION {
      ?from a pk:DailyJournal ;
        prov:wasGeneratedBy ?to .
      BIND("created by" AS ?relation)
      BIND("daily_journal" AS ?fromKind)
      BIND("pi_durable_task" AS ?toKind)
    } UNION {
      ?page <https://schema.org/hasPart> ?from .
      ?from prov:wasGeneratedBy ?to .
      ?page <urn:pk:digital-twin:predicate:recordKind> "codex_daily_journal" .
      BIND("generated by" AS ?relation)
      BIND("journal_record" AS ?fromKind)
      BIND("pi_durable_task" AS ?toKind)
    }
    OPTIONAL { ?from schema:name ?fromName }
    OPTIONAL { ?from schema:identifier ?fromIdentifier }
    OPTIONAL { ?to schema:name ?toName }
    OPTIONAL { ?to schema:identifier ?toIdentifier }
    OPTIONAL { ?to pk:piDurableTaskId ?taskId }
    BIND(COALESCE(?fromName, ?fromIdentifier, STRAFTER(STR(?from), "urn:pk:")) AS ?fromLabel)
    BIND(COALESCE(?toName, ?toIdentifier, ?taskId, STRAFTER(STR(?to), "urn:pk:")) AS ?toLabel)
  }
  } UNION {
    GRAPH <urn:pk:digital-twin:graph:assertion-classification> {
      ?from <urn:pk:digital-twin:predicate:recordKind> "systemone_assertion_classification" ;
        schema:isBasedOn ?to ;
        schema:additionalType ?assertionKind ;
        <urn:pk:digital-twin:predicate:confidence> ?confidence .
    }
    BIND("classification" AS ?relation)
    BIND("classifier_annotation" AS ?fromKind)
    BIND("journal_record" AS ?toKind)
    BIND(CONCAT("SystemOne · ", ?assertionKind, " · ", STR(ROUND(?confidence * 100)), "%") AS ?fromLabel)
    BIND("unreviewed assertion prediction" AS ?toLabel)
    BIND(REPLACE(STRAFTER(STR(?to), "urn:pk:"), ":reflection:[^:]+$", "") AS ?fromEntryId)
  } UNION {
    GRAPH <urn:pk:digital-twin:graph:assertion-classification> {
      ?from a oa:Annotation ;
        oa:motivatedBy oa:classifying ;
        oa:hasTarget ?to ;
        oa:hasBody ?decision .
      ?decision a pk:ClassificationDecision ;
        pk:predictedKind ?assertionKind ;
        pk:confidence ?confidence .
      OPTIONAL { ?assertionKind <http://www.w3.org/2004/02/skos/core#prefLabel> ?assertionLabel }
    }
    BIND("classification" AS ?relation)
    BIND("classifier_annotation" AS ?fromKind)
    BIND("source_evidence" AS ?toKind)
    BIND(CONCAT("SystemOne · ", COALESCE(STR(?assertionLabel), STRAFTER(STR(?assertionKind), "assertion-kind:")), " · ", STR(ROUND(?confidence * 100)), "%") AS ?fromLabel)
    BIND("unreviewed assertion prediction" AS ?toLabel)
  }
}
ORDER BY ?from ?to
LIMIT 4000
