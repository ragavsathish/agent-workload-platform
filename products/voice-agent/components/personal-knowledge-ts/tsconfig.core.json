{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "outDir": "build/core",
    "rootDir": "src/core",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/core/**/*.ts", "src/core/generated/**/*.d.ts"]
}
