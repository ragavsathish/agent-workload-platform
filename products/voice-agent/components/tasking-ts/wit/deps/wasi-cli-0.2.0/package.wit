package wasi:cli@0.2.0;

interface environment {
    /// Return the environment variables granted to this component.
    get-environment: func() -> list<tuple<string, string>>;

    /// Return the component's command-line arguments.
    get-arguments: func() -> list<string>;

    /// Return the component's initial working directory when one exists.
    initial-cwd: func() -> option<string>;
}
