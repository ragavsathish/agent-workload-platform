# All inference endpoints remain on this Mac. Copy this file to .env and keep it private.

# Add the exact HTTPS hostname printed by `tailscale serve status`.
PIPECAT_ALLOWED_ORIGINS=http://localhost:7860,http://localhost:5173,https://mac-mini.example-tailnet.ts.net

# Local MLX Whisper. large-v3-turbo-q4 is a good M4 Pro latency/quality tradeoff.
MLX_STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3

# Local MLX Audio Kokoro.
MLX_TTS_MODEL=mlx-community/Kokoro-82M-bf16
MLX_TTS_VOICE=af_heart
MLX_TTS_LANGUAGE_CODE=a
MLX_TTS_SPEED=1.0
MLX_TTS_STREAMING_INTERVAL=0.5

# Ollama is local-only. The MLX tag keeps the whole inference stack on Apple MLX.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:9b-mlx

# Capability used only by the isolated edge to call the narrow inference broker.
INFERENCE_BROKER_TOKEN=replace-with-at-least-32-random-characters
# Separate capability for the four narrow voice task lifecycle routes.
AGENT_GATEWAY_TOKEN=replace-with-another-at-least-32-random-characters
# Optional; `make up` generates and preserves this restricted writer capability.
DIGITAL_TWIN_WRITER_TOKEN=
DIGITAL_TWIN_READER_TOKEN=
BROKER_MAX_AUDIO_BYTES=4194304
BROKER_MAX_AUDIO_SECONDS=45
BROKER_MAX_CHAT_BYTES=131072
BROKER_MAX_TTS_CHARS=2000

# Postgres/Absurd are the only durable task authority. Generate fresh secrets:
#   openssl rand -hex 24
#   openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-password
# Optional override; make up otherwise generates and preserves this in deploy/secrets.
GRAFANA_ADMIN_PASSWORD=
# `make login` replaces these local defaults with the authenticated tailnet URLs.
GRAFANA_ROOT_URL=http://127.0.0.1:3300/
GITEA_ROOT_URL=http://127.0.0.1:3001/
DATABASE_URL=postgresql://voice_agents:replace-with-the-same-password@127.0.0.1:54329/voice_agents
ABSURD_QUEUE=agents
IMAGE_BUILD_TIMEOUT_SECONDS=7200
GITEA_IMAGE_WORKFLOW=build-execution-image.yml
GITEA_WORKFLOW_REF=refs/heads/main
NODE_BINARY=/opt/homebrew/bin/node
ORCHESTRATOR_APPROVAL_SECRET=replace-with-at-least-32-random-characters
ORCHESTRATOR_APPROVAL_TTL_SECONDS=300

# `make login` pins this single owner; tailnet ACLs authenticate reachable devices.
ORCHESTRATOR_ALLOWED_USERS=you@example.com
ORCHESTRATOR_ALLOW_LOCAL_DEV=true
# Logical workspace names are resolved to immutable Git bundles in S3Mock.
ORCHESTRATOR_ALLOWED_WORKSPACES=agent-workload-platform
VOICE_DEFAULT_WORKSPACE=agent-workload-platform
# Server-side microphone filter. Keep `rnnoise` for rollback; `voxlock` isolates
# the enrolled target voice before VAD and transcription.
VOICE_INPUT_FILTER=rnnoise
# Keep raw, VoxLock, and RNNoise input replays for the five most recent completed
# conversations. Recordings stay in a private Docker volume and are tailnet-only.
VOICE_DIAGNOSTIC_MAX_SECONDS=1800
# Mono 16 kHz PCM16 WAV containing at least three seconds of clean owner speech.
# `make up` extracts the strongest three seconds into an ignored 0600 secret.
VOXLOCK_VOICE_SAMPLE_SOURCE=
ARTIFACT_ENDPOINT_URL=http://127.0.0.1:9090
GITEA_ENDPOINT_URL=http://127.0.0.1:3001
GITEA_OWNER=source-publisher
ARTIFACT_BUCKET=agent-artifacts
ARTIFACT_ACCESS_KEY=local-test
ARTIFACT_SECRET_KEY=local-test

# Pi runs on the host for model/auth; its read/write/bash tools run in Gondolin.
PI_BINARY=/opt/homebrew/bin/pi
PI_MODEL=
PI_THINKING=medium
PI_SESSION_DIR=~/.pi/agent/sessions
PI_GONDOLIN_EXTENSION=/absolute/path/to/agent-workload-platform/platform/agent-execution/gondolin-session/dist/pi-extension.js
# Task VMs get public HTTP(S) egress. Gondolin still blocks private, loopback,
# link-local, and cloud-metadata destinations.
GONDOLIN_PUBLIC_INTERNET=1
# Optional voice-conversation backend. Set VOICE_LLM_BACKEND=pi in edge/.env,
# then choose the Pi model here. Blank uses Pi's configured default model.
PI_VOICE_MODEL=
PI_VOICE_THINKING=low
PI_VOICE_TIMEOUT_SECONDS=120
PI_VOICE_SERVICE_URL=http://127.0.0.1:9446
WORKER_ALLOW_UNSANDBOXED=false
WORKER_TASK_TIMEOUT_SECONDS=1800
WORKER_MAX_OUTPUT_BYTES=1048576
WORKER_MAX_ARTIFACT_BYTES=16777216
WORKER_SCRATCH_ROOT=~/.local/share/agent-workload-platform/workspaces
