FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0 AS download

ARG TARGETARCH
ARG HABITAT_VERSION=0.5.0

RUN set -eu; \
    case "$TARGETARCH" in \
      arm64) asset=habitat-linux-arm64; checksum=0e44b8326e6682f1b76dfb03517705a459593b3a6fa37df5bb9eef6dff0b0e5d ;; \
      amd64) asset=habitat-linux-x86_64; checksum=0865c9cbd323f38dd61f841de2216b4cbf2377b80679040b2ffa85253702f5f9 ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    wget -q "https://github.com/earendil-works/absurd/releases/download/${HABITAT_VERSION}/${asset}" -O /habitat; \
    echo "${checksum}  /habitat" | sha256sum -c -; \
    chmod 0555 /habitat

FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0

COPY --from=download /habitat /usr/local/bin/habitat
COPY --chmod=0555 deploy/habitat/entrypoint.sh /usr/local/bin/habitat-entrypoint

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/habitat-entrypoint"]
CMD ["run"]
