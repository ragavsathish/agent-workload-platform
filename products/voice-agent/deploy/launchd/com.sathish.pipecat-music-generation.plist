<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sathish.pipecat-music-generation</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--no-sync</string>
    <string>python</string>
    <string>-m</string>
    <string>acestep.api_server</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8001</string>
    <string>--init-llm</string>
    <string>--lm-model-path</string><string>acestep-5Hz-lm-1.7B</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sathish.narayanan/Library/Application Support/PipecatEdge/apps/music-generation</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/sathish.narayanan/Library/Application Support/PipecatEdge/runtime-home</string>
    <key>HF_HOME</key><string>/Users/sathish.narayanan/.cache/huggingface</string>
    <key>ACESTEP_NO_INIT</key><string>false</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>Umask</key><integer>63</integer>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/sathish.narayanan/Library/Logs/PipecatEdge/music-generation.log</string>
  <key>StandardErrorPath</key><string>/Users/sathish.narayanan/Library/Logs/PipecatEdge/music-generation.log</string>
</dict>
</plist>
