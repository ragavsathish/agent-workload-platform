<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sathish.pipecat-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--no-sync</string>
    <string>--env-file</string><string>worker.env</string>
    <string>python</string><string>-m</string><string>voice_worker.main</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sathish.narayanan/Library/Application Support/PipecatEdge/apps/worker</string>
  <key>RunAtLoad</key><true/>
