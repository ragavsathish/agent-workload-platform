              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "expression": "A",
                "type": "reduce",
                "reducer": "last",
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        2
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "1m",
          "annotations": {
            "summary": "The browser-facing task path failed more than once in five minutes."
          },
          "labels": {
            "managed_by": "agent-workload-platform",
            "auto_investigate": "true"
          }
        },
        {
          "uid": "awp_owner_transport_errors",
          "title": "Pi Durable owner transport failure",
          "condition": "C",
          "data": [
            {
              "refId": "A",
