{
  "annotations": {
    "list": []
  },
  "description": "Host data-volume capacity, platform cache directories, and Docker disk usage. APFS available space is shared across volumes. Directory and Docker figures refresh about once a minute and should not be added to the host total.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Bytes available to ordinary processes on the macOS data volume.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 21474836480
              },
              {
                "color": "green",
                "value": 53687091200
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{system=\"macos-host\",layer=\"host\",mountpoint=\"/System/Volumes/Data\"}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Host free space",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Total data-volume bytes less bytes available to ordinary processes.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{system=\"macos-host\",layer=\"host\",mountpoint=\"/System/Volumes/Data\"} / node_filesystem_size_bytes{system=\"macos-host\",layer=\"host\",mountpoint=\"/System/Volumes/Data\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Host disk occupied",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Docker's estimate of space reclaimable across images, containers, volumes, and build cache. Review before deleting volumes or images.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(platform_docker_storage_reclaimable_bytes)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Docker reclaimable",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Versioned OCI archives retained for Gondolin task image installation.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "platform_storage_directory_bytes{area=\"image_handoff\"}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Task image archives",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Available space on the shared APFS data volume over time.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{system=\"macos-host\",layer=\"host\",mountpoint=\"/System/Volumes/Data\"}",
          "legendFormat": "Host free",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Host free space over time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Selected platform directories measured with du. These are separate directory totals, not a partition of the entire disk.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 6,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "platform_storage_directory_bytes",
          "instant": true,
          "legendFormat": "{{area}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Platform directories",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Docker disk usage by object type, as reported by docker system df.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 7,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "platform_docker_storage_size_bytes",
          "instant": true,
          "legendFormat": "{{kind}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Docker storage",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Docker's reclaimable estimate by object type. Active dependencies should be reviewed before cleanup.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "platform_docker_storage_reclaimable_bytes",
          "legendFormat": "{{kind}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Docker reclaimable over time",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "voice",
    "system",
    "storage",
    "macos",
    "docker",
    "gondolin"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Storage Capacity",
  "uid": "voice-storage-capacity",
  "version": 1
}
