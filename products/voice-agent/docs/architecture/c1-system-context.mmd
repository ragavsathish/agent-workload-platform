flowchart LR
    %% C4 system-context view. Keep relationship labels short so generated renders remain readable.
    subgraph PEOPLE["People"]
        direction TB
        VOICE_USER(["Person<br/><b>Voice Operator</b><br/>browser conversation and orchestration"])
        TASK_USER(["Person<br/><b>Task Operator</b><br/>explicit durable-task operations"])
    end

    SYSTEM["Software system<br/><b>Voice Agent</b><br/>persistent Pi conversation, visual and spoken responses,<br/>and durable agent tasks"]

    subgraph EXTERNALS["External systems"]
        direction TB
        TAILSCALE["External system<br/><b>Tailscale Control Plane</b><br/>device and private-network authority"]
        TELEGRAM["External system<br/><b>Telegram Bot API</b><br/>task commands and bounded results"]
        MODELS["External system<br/><b>Model Providers</b><br/>conversational and task models"]
        INTEGRATIONS["External system<br/><b>External Integrations</b><br/>permission-scoped optional APIs"]
    end

    VOICE_USER -->|"voice · diagrams · transcripts<br/>Tailnet HTTPS and WebRTC"| SYSTEM
    TASK_USER -->|"create · approve · inspect · cancel"| TELEGRAM
    SYSTEM -->|"long poll · task views"| TELEGRAM
    SYSTEM -.->|"private-network configuration"| TAILSCALE
    SYSTEM -->|"provider APIs"| MODELS
    SYSTEM -->|"scoped HTTPS"| INTEGRATIONS

    classDef person fill:#084c8d,color:#fff,stroke:#05345f,stroke-width:2px;
    classDef system fill:#1168bd,color:#fff,stroke:#0b4884,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    class VOICE_USER,TASK_USER person;
    class SYSTEM system;
    class TAILSCALE,TELEGRAM,MODELS,INTEGRATIONS external;
