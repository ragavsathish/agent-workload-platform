flowchart TB
    %% C4 container view. Each blue node is an independently running application or data store.
    USER(["Person<br/><b>Tailnet User</b><br/>talks, listens, reviews, delegates"])
    TSC["External system<br/><b>Tailscale Control Plane</b><br/>device and network authority"]
    MODELS["External system<br/><b>Model Providers</b><br/>Pi conversational and task models"]
    INTEGRATIONS["External system<br/><b>External Integrations</b><br/>optional permission-scoped APIs"]

    subgraph SYSTEM["Voice Agent · system boundary"]
        direction TB

        subgraph VOICE["Interactive voice path"]
            direction LR
            BROWSER["Container<br/><b>Browser Client</b><br/>React · Pipecat RTVI"]
            INGRESS["Container<br/><b>Tailnet Ingress</b><br/>Tailscale Serve"]
            ROUTER["Container<br/><b>Path Router</b><br/>Traefik · exact-owner forward-auth"]
            EDGE["Container<br/><b>Voice Edge</b><br/>Python · Pipecat · RNNoise/VoxLock · FastAPI"]
            BROKER["Container<br/><b>Inference Broker</b><br/>Python · FastAPI · MLX"]
            PI["Container<br/><b>Pi Voice Service</b><br/>TypeScript · Pi coding agent"]
            VOICE_VM["Container<br/><b>Voice Tool Sandbox</b><br/>Gondolin · Git/Tea/AWS CLI · workspace RW · skills RO"]
            BROWSER -->|"signaling · audio · UI"| INGRESS
            INGRESS -->|"localhost HTTP<br/>authenticated identity"| ROUTER
            ROUTER -->|"/ · WebSocket"| EDGE
            EDGE -->|"STT · Pi stream · TTS · context"| BROKER
            BROKER -->|"turns · transcript · context"| PI
            PI -->|"read · write · edit · shell"| VOICE_VM
        end

        subgraph TASK["Durable delegated-work path"]
            direction LR
            GATEWAY["Container<br/><b>Agent Gateway</b><br/>Python · FastAPI"]
            TASKS[("Container database<br/><b>Task Database and Queue</b><br/>PostgreSQL · Absurd schema")]
            HABITAT["Container<br/><b>Durable Queue Dashboard</b><br/>Go · Absurd Habitat"]
            WORKER["Container<br/><b>Pi Task Worker</b><br/>Python · Pi coding agent"]
            BUILDER_MANAGER["Container<br/><b>Builder VM Manager</b><br/>Node.js · launchd"]
            BUILDER_VM["Container<br/><b>Shared Image Builder</b><br/>Gondolin · Gitea Runner · private Docker"]
            TASK_TOOLS["Container<br/><b>Task Tool Runtime</b><br/>Gondolin · optional Wassette"]
            GATEWAY -->|"persist · enqueue"| TASKS
            HABITAT -->|"inspect · retry<br/>scoped SQL"| TASKS
            TASKS -->|"claim · checkpoint"| WORKER
            WORKER -->|"dispatch · observe · cancel image workflow"| GITEA
            GITEA -->|"assign trusted workflow job"| BUILDER_VM
            BUILDER_MANAGER -->|"resume · checkpoint"| BUILDER_VM
            WORKER -->|"isolated tools"| TASK_TOOLS
        end

        subgraph DATA["Runtime data and operations"]
            direction LR
            VOICE_DATA[("Container data store<br/><b>Voice Runtime Data</b><br/>sessions · workspace · skills")]
            GITEA[("Container data store<br/><b>Git and Image Packages</b><br/>rootless Gitea · refs · immutable assets")]
            ARTIFACTS[("Container data store<br/><b>Workspace and Result Store</b><br/>S3-compatible object storage")]
            DOCKER_METRICS["Container<br/><b>Docker VM Metrics</b><br/>Fluent Bit · Linux VM aggregate"]
            HOST_METRICS["Container<br/><b>Host and Gondolin Metrics</b><br/>Fluent Bit · QEMU process exporter"]
            OTEL["Container<br/><b>Metrics and Traces</b><br/>OpenTelemetry LGTM"]
        end

        EDGE -->|"browser task API"| GATEWAY
        PI -->|"voice task tools"| GATEWAY
        PI -->|"session · workspace · skills"| VOICE_DATA
        VOICE_VM -->|"clone · restricted read API · synthetic allowlist"| GITEA
        VOICE_VM -->|"AWS CLI · S3Mock-only HTTP"| ARTIFACTS
        GATEWAY -->|"resolve workspace"| ARTIFACTS
        ARTIFACTS -->|"materialize · capture result"| WORKER
        BUILDER_VM -->|"upload checksummed assets<br/>restricted workflow secret"| GITEA
        GITEA -->|"download image assets"| WORKER
        EDGE -.->|"metrics · traces"| OTEL
        BROKER -.->|"metrics · traces"| OTEL
        GATEWAY -.->|"metrics · traces"| OTEL
        PI -.->|"register voice VM PID"| HOST_METRICS
        WORKER -.->|"register task VM PID"| HOST_METRICS
        DOCKER_METRICS -->|"private scrape<br/>Docker VM resources"| OTEL
        HOST_METRICS -->|"loopback scrape<br/>Mac · each Gondolin VM"| OTEL
        ROUTER -->|"/metrics/"| OTEL
        ROUTER -->|"/git/"| GITEA
        ROUTER -->|"/queue/"| HABITAT
    end

    USER -->|"tailnet HTTPS · WebRTC"| BROWSER
    INGRESS -.->|"control protocol"| TSC
    PI -->|"provider API"| MODELS
    WORKER -->|"provider API"| MODELS
    TASK_TOOLS -->|"declared capabilities"| INTEGRATIONS

    classDef person fill:#084c8d,color:#fff,stroke:#05345f,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef container fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class USER person;
    class TSC,MODELS,INTEGRATIONS external;
    class BROWSER,INGRESS,ROUTER,EDGE,BROKER,PI,VOICE_VM,GATEWAY,HABITAT,WORKER,BUILDER_MANAGER,BUILDER_VM,TASK_TOOLS,DOCKER_METRICS,HOST_METRICS,OTEL container;
    class TASKS,VOICE_DATA,GITEA,ARTIFACTS data;
