flowchart LR
    USER([Person<br/><b>Tailnet User</b>])
    EDGE[External container<br/><b>Voice Edge</b><br/>WebRTC and owner-scoped HTTP APIs]

    subgraph BROWSER["Container: Browser Client · React + Pipecat RTVI"]
        direction TB
        SHELL["Component<br/><b>Pipecat App Shell</b><br/>creates the RTVI client and transport"]
        CONTROLS["Component<br/><b>Conversation Controller</b><br/>start, mute, stop, and activity state"]
        DIAGRAM["Component<br/><b>Response Diagram</b><br/>strict Mermaid rendering with stale-render protection"]
        CONTEXT["Component<br/><b>Context Controller</b><br/>polls usage and requests compaction"]
        TASKS["Component<br/><b>Task Panel</b><br/>propose, approve, cancel, poll, and replay"]
        TRANSCRIPT["Component<br/><b>Transcript View</b><br/>polls the bounded public Pi transcript"]
        AUDIO["Component<br/><b>Audio Diagnostics View</b><br/>live charts and last-five replay comparison"]

        SHELL -->|"client and connection callbacks"| CONTROLS
        CONTROLS -->|"server Mermaid messages"| DIAGRAM
        TASKS -->|"completed-task Mermaid"| DIAGRAM
    end

    USER -->|"operates"| CONTROLS
    USER -->|"reviews"| DIAGRAM
    USER -->|"manages work"| TASKS
    USER -->|"opens"| TRANSCRIPT
    USER -->|"inspects"| AUDIO
    SHELL -->|"WebRTC signaling and media"| EDGE
    CONTEXT -->|"GET usage · POST compact"| EDGE
    TASKS -->|"task lifecycle and WAV replay"| EDGE
    TRANSCRIPT -->|"poll transcript"| EDGE
    AUDIO -->|"poll metrics and fetch WAV"| EDGE

    classDef person fill:#084c8d,color:#fff,stroke:#05345f,stroke-width:2px;
    classDef component fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    class USER person;
    class SHELL,CONTROLS,DIAGRAM,CONTEXT,TASKS,TRANSCRIPT,AUDIO component;
    class EDGE external;
