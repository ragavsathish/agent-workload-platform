flowchart TB
    GITEA[External system<br/><b>Gitea Actions</b><br/>assigns trusted repository jobs]
    SOURCE[(External data<br/><b>Gitea Repository</b><br/>workflow and immutable revision)]
    HOST_DOCKER[External system<br/><b>Host Docker Engine</b><br/>shared layer cache · builds and pulls]
    HANDOFF[(Host filesystem<br/><b>Image Handoff</b><br/>versioned image tar files)]
    INTERNET[External system<br/><b>Public Package Sources</b><br/>build dependencies]
    OTEL[External system<br/><b>OTel LGTM</b><br/>runner metrics and job traces]

    subgraph HOST["Deployment node: macOS host"]
        MANAGER["Container<br/><b>Builder VM Manager</b><br/>starts, monitors, and checkpoints one warm VM"]
        API["Container<br/><b>Docker Job API</b><br/>Go · authenticated jobs · streamed contexts"]
        CHECKPOINT[("Builder disk checkpoint<br/>runner registration and workflow state")]
        subgraph VM["Deployment node: Shared Gondolin Builder VM · trusted repositories only"]
            RUNNER["Component<br/><b>Gitea Runner</b><br/>capacity one · Docker CLI/Compose"]
            CLIENT["Component<br/><b>Image Workflow Client</b><br/>packages context · submits and polls host job"]
            RUNNER --> CLIENT
        end
        MANAGER -->|"creates or resumes"| VM
        MANAGER -->|"writes on graceful stop"| CHECKPOINT
    end

    GITEA -->|"one labeled job at a time"| RUNNER
    RUNNER -->|"checks out requested revision"| SOURCE
    CLIENT -->|"context · status<br/>authenticated HTTP hook"| API
    API -->|"Docker Engine API<br/>Unix socket"| HOST_DOCKER
    HOST_DOCKER -->|"pulls build dependencies"| INTERNET
    HOST_DOCKER -->|"saves image tar"| HANDOFF
    MANAGER -.->|"lifecycle metrics and traces"| OTEL
    RUNNER -.->|"native OTLP job traces and metrics"| OTEL

    classDef component fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef container fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class RUNNER,CLIENT component;
    class MANAGER,API container;
    class GITEA,INTERNET,OTEL,HOST_DOCKER external;
    class SOURCE,HANDOFF,CHECKPOINT data;
