flowchart LR
    TASK[External container<br/><b>Pi Durable Owner</b><br/>task admission and durable checkpoints]
    GITEA[External system<br/><b>Gitea Actions</b><br/>workflow dispatch and run state]
    HANDOFF[(Host filesystem<br/><b>Image Handoff</b><br/>versioned image tar files)]

    subgraph WORKER["Container: Pi Task Worker · Python"]
        direction TB
        PLAN["Component<br/><b>Execution Image Planner</b><br/>validates declaration and computes content key"]
        CACHE["Component<br/><b>Local Handoff Lookup</b><br/>checks the versioned host archive"]
        ACTIONS["Component<br/><b>Gitea Actions Client</b><br/>dispatches, observes, and cancels workflow runs"]
        INSTALL["Component<br/><b>Local Image Installer</b><br/>loads tar and registers Gondolin image ref"]
        PLAN --> CACHE
        CACHE -->|"cache miss"| ACTIONS
        CACHE -->|"cache hit"| INSTALL
        ACTIONS -->|"successful run"| CACHE
    end

    TASK -->|"prepares image and checkpoints workflow run ID"| WORKER
    ACTIONS -->|"workflow dispatch, status, cancel"| GITEA
    HANDOFF -->|"versioned tar"| INSTALL

    classDef component fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class PLAN,CACHE,ACTIONS,INSTALL component;
    class GITEA external;
    class TASK external;
    class HANDOFF data;
