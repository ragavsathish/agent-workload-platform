flowchart LR
    USER([Person<br/><b>Tailnet User</b>])
    EDGE[External container<br/><b>Voice Edge</b><br/>owner-scoped diagnostics and replay APIs]

    subgraph DIAGNOSTICS["Container: Input Diagnostics · React"]
        direction TB
        PAGE["Component<br/><b>Diagnostics Page</b><br/>loads the latest five completed voice sessions"]
        LIVE["Component<br/><b>Live Input Monitor</b><br/>polls and plots the active microphone envelope"]
        REPLAY["Component<br/><b>Session Replay</b><br/>plays raw and selected-filter audio"]
        CHARTS["Component<br/><b>Model Charts</b><br/>plots energy, suppression, latency, LSTM state, and masks"]
        API["Component<br/><b>Diagnostics API Adapter</b><br/>same-origin fetch with runtime validation"]

        PAGE -->|"refreshes sessions"| API
        PAGE -->|"shows"| LIVE
        PAGE -->|"selects a session"| REPLAY
        PAGE -->|"selects a session"| CHARTS
        LIVE -->|"polls live envelope"| API
        REPLAY -->|"streams raw and selected WAV"| API
        CHARTS -->|"loads metric series"| API
    end

    USER -->|"inspects and replays"| PAGE
    API -->|"HTTPS JSON and WAV"| EDGE

    classDef person fill:#084c8d,color:#fff,stroke:#05345f,stroke-width:2px;
    classDef component fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    class USER person;
    class PAGE,LIVE,REPLAY,CHARTS,API component;
    class EDGE external;
