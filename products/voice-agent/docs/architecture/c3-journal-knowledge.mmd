flowchart LR
    %% C4 component view of the Journal & Knowledge browser application.
    BROWSER["External container<br/><b>Browser Voice Client</b><br/>opens the knowledge route"]
    ROUTER["External container<br/><b>Path Router</b><br/>owner-scoped SPARQL query route"]
    EDGE["External container<br/><b>Voice Edge</b><br/>serves assets and forwards review commands"]

    subgraph KNOWLEDGE["Journal & Knowledge"]
        direction TB
        VIEW["Component<br/><b>Knowledge View</b><br/>loads entries and coordinates selection"]
        FILTER["Component<br/><b>Journal Filters</b><br/>type, date, topic, and search state"]
        GRAPH["Component<br/><b>Knowledge Graph</b><br/>Cytoscape relationships and node selection"]
        NOTE["Component<br/><b>Note and Source</b><br/>selected note and originating capture"]
        REVIEW["Component<br/><b>Review Forms</b><br/>correction and assertion decisions"]
        API["Component<br/><b>Journal API and WASM</b><br/>bounded SPARQL decode and command encode"]
        VIEW -->|"applies filters"| FILTER
        VIEW -->|"shows linked relationships"| GRAPH
        VIEW -->|"shows evidence"| NOTE
        VIEW -->|"opens owner actions"| REVIEW
        VIEW -->|"fetches journal entries"| API
        REVIEW -->|"encodes review command"| API
    end

    BROWSER -->|"opens /knowledge/"| VIEW
    API -->|"POST /oxigraph/query<br/>read-only SPARQL"| ROUTER
    API -->|"/api/knowledge/journal<br/>owner review commands"| EDGE

    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef component fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    class BROWSER,ROUTER,EDGE external;
    class VIEW,FILTER,GRAPH,NOTE,REVIEW,API component;
