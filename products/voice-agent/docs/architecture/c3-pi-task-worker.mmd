flowchart TB
    DB[(External data store<br/><b>PostgreSQL</b><br/>agent-run and image-build queues)]
    S3[(External data store<br/><b>S3Mock</b><br/>immutable source and bounded results)]
    HANDOFF[(Host filesystem<br/><b>Image Handoff</b><br/>versioned image tar files)]
    PI[External container<br/><b>Pi Task Session</b><br/>Pi CLI with in-process Gondolin extension]

    subgraph WORKER["Container: Pi Task Worker · native Python + Absurd"]
        direction TB
        CLAIM["Component<br/><b>Agent-Run Handler</b><br/>claims one task with concurrency one"]
        MATERIALIZE["Component<br/><b>Workspace Materializer</b><br/>download, digest-check, and detached checkout"]
        PLAN["Component<br/><b>Execution Image Planner</b><br/>reads versioned .pi/gondolin configuration"]
        BUILD["Component<br/><b>Image Build Coordinator</b><br/>spawn child task, durably await, verify, and install"]
        INTENT["Component<br/><b>Irreversible Intent Checkpoint</b><br/>prevents unsafe Pi replay after a crash"]
        COMMAND["Component<br/><b>Pi Command Builder</b><br/>fixed flags, model, skill, and extension selection"]
        EXECUTE["Component<br/><b>Pi Process Runner</b><br/>bounded stdout/stderr and timeout"]
        PROGRESS["Component<br/><b>Progress Projector</b><br/>maps event type and tool name to safe phrases"]
        NORMALIZE["Component<br/><b>Response Normalizer</b><br/>extracts text, spoken response, and Mermaid"]
        CAPTURE["Component<br/><b>Result Capturer</b><br/>bounded binary patch, status, and execution JSON"]

        CLAIM --> MATERIALIZE --> PLAN --> BUILD --> INTENT --> COMMAND --> EXECUTE --> NORMALIZE --> CAPTURE
    end

    DB -->|"claim agent-run"| CLAIM
    CLAIM -->|"steps and final checkpoint"| DB
    MATERIALIZE -->|"source bundle"| S3
    BUILD -->|"spawn and await image-build"| DB
    BUILD -->|"read local image tar"| HANDOFF
    EXECUTE -->|"one no-session invocation"| PI
    EXECUTE -->|"Pi JSON events"| PROGRESS
    PROGRESS -->|"bounded spoken progress"| DB
    CAPTURE -->|"write task artifacts"| S3
    CAPTURE -->|"completed result"| DB

    classDef component fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class CLAIM,MATERIALIZE,PLAN,BUILD,INTENT,COMMAND,EXECUTE,PROGRESS,NORMALIZE,CAPTURE component;
    class PI,RUNTIME external;
    class DB,S3,HANDOFF data;
