flowchart LR
    GATEWAY["External container<br/><b>Agent Gateway</b><br/>owner-scoped task submissions"]
    S3[("External data store<br/><b>S3Mock</b><br/>workspace and result artifacts")]
    SQLITE[("External data store<br/><b>Owner SQLite</b><br/>one writer; native task state")]
    SESSION[("External data store<br/><b>Task Pi SQLite</b><br/>native conversation state")]
    GONDOLIN["External container<br/><b>Gondolin Task VM</b><br/>isolated tools"]
    MODEL["External system<br/><b>Model Provider</b>"]

    subgraph OWNER["Container: Pi Durable Owner · Node.js LaunchAgent"]
        HTTP["Component<br/><b>Private HTTP Transport</b><br/>bearer token; bounded JSON"]
        SOCKET["Component<br/><b>Unix Socket Interface</b><br/>inspect, abort, retry"]
        HARNESS["Component<br/><b>Pi Durable Harness</b><br/>native task scheduler and retryTask"]
        TASKS["Component<br/><b>Product Task Definitions</b><br/>agent, lyrics, render, journal, classify"]
        PI["Component<br/><b>Pi Durable Session</b><br/>native conversation, tools, and MCP"]
        ENV["Component<br/><b>Execution Environment</b><br/>host or Gondolin guest"]
        HTTP --> HARNESS
        SOCKET --> HARNESS
        HARNESS --> TASKS
        TASKS --> PI --> ENV
    end

    subgraph EFFECTS["Effect helpers · bounded Python child"]
        MATERIALIZE["Component<br/><b>Workspace Materializer</b><br/>scratch or immutable source"]
        CAPTURE["Component<br/><b>Result Capturer</b><br/>bounded patch, status, and result"]
    end

    GATEWAY -->|"submit, query, abort over HTTP"| HTTP
    HARNESS -->|"native checkpoints and results"| SQLITE
    TASKS -->|"prepare workspace"| MATERIALIZE
    MATERIALIZE -->|"read workspace"| S3
    PI -->|"native conversation checkpoints"| SESSION
    ENV -->|"Gondolin mode: isolated tools"| GONDOLIN
    PI -->|"model requests"| MODEL
    PI -->|"final text"| CAPTURE
    CAPTURE -->|"write artifacts"| S3
    classDef component fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class HTTP,SOCKET,HARNESS,TASKS,PI,ENV,MATERIALIZE,CAPTURE component;
    class GATEWAY,GONDOLIN,MODEL external;
    class S3,SQLITE,SESSION data;
