flowchart LR
    TASK["External component<br/><b>Product Task</b><br/>approved instruction and workspace"]
    SQLITE[("External data store<br/><b>Task Pi SQLite</b><br/>native conversation and tool checkpoints")]
    WORKSPACE[("External data<br/><b>Task Workspace</b><br/>host path mounted at VM /workspace")]
    SKILLS[("External data<br/><b>Trusted Skills</b><br/>host path or read-only VM /skills")]
    MODEL["External system<br/><b>Model Provider</b>"]
    GONDOLIN["External container<br/><b>Gondolin Task VM</b><br/>isolated guest file and shell tools"]
    MCP["External systems<br/><b>Allowlisted MCP Servers</b><br/>product integrations"]

    subgraph OWNER["Container: Pi Durable Owner · task-session components"]
        MODE["Component<br/><b>Mode Selector</b><br/>host or Gondolin deployment setting"]
        SESSION["Component<br/><b>Pi Durable Session</b><br/>native submission, tool replay, and model turns"]
        REGISTRY["Component<br/><b>Tool Registry</b><br/>CodingTools and allowlisted MCP"]
        HOST["Component<br/><b>NodeExecutionEnv</b><br/>Mac host file and shell tools"]
        GUEST["Component<br/><b>GondolinExecutionEnv</b><br/>guest file and shell capability"]
        BRIDGE["Component<br/><b>Task Socket Bridge</b><br/>bounded voice follow-up"]
        MODE --> SESSION --> REGISTRY
        MODE -->|"host"| HOST
        MODE -->|"gondolin"| GUEST
        SESSION --> BRIDGE
    end

    TASK --> MODE
    SESSION --> SQLITE
    SESSION --> MODEL
    REGISTRY --> MCP
    HOST --> WORKSPACE
    GUEST --> GONDOLIN --> WORKSPACE
    GONDOLIN --> SKILLS
    HOST --> SKILLS

    classDef component fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class MODE,SESSION,REGISTRY,HOST,GUEST,BRIDGE component;
    class TASK,MODEL,GONDOLIN,MCP external;
    class SQLITE,WORKSPACE,SKILLS data;
