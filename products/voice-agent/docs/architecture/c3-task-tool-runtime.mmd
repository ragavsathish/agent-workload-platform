flowchart LR
    WORKER[External container<br/><b>Pi Task Worker</b><br/>starts one bounded Pi CLI process]
    WORKSPACE[(External data<br/><b>Task Workspace</b><br/>mounted at /workspace)]
    SKILLS[(External data<br/><b>Trusted Skills</b><br/>optional read-only /skills)]
    MEMORY[(External data store<br/><b>Browser Memory</b><br/>local JSONL MCP storage)]
    GITHUB[External system<br/><b>GitHub API</b><br/>optional scoped integration]
    WASSETTE_RUNTIME[External container<br/><b>Wassette Integration Runtime</b><br/>native per-session MCP subprocess]

    subgraph RUNTIME["Container: Pi Task Session · Pi CLI + in-process Gondolin extension"]
        direction TB
        CONFIG["Component<br/><b>Project Runtime Resolver</b><br/>reads .pi/gondolin.json and in-repo network policy"]
        LIFECYCLE["Component<br/><b>Extension Lifecycle</b><br/>start, prompt augmentation, and shutdown"]
        VM["Component<br/><b>Gondolin Tool Client</b><br/>isolated bash and optional Playwright MCP"]
        MEM["Component<br/><b>Memory MCP Client</b><br/>optional durable browser knowledge"]
        WASSETTE["Component<br/><b>Wassette MCP Client</b><br/>loads configured component and grants explicit capabilities"]
        POLICY["Component<br/><b>GitHub Tool Policy</b><br/>read allowlist; writes require explicit enablement"]
        REGISTRY["Component<br/><b>Tool Registrar</b><br/>normalizes schemas and bounds returned output"]

        CONFIG --> LIFECYCLE --> VM
        LIFECYCLE --> MEM
        LIFECYCLE --> WASSETTE --> POLICY
        VM --> REGISTRY
        MEM --> REGISTRY
        POLICY --> REGISTRY
    end

    WORKER -->|"start one process"| LIFECYCLE
    CONFIG -->|"select image, CPU, memory, egress"| VM
    VM -->|"read-write mount"| WORKSPACE
    VM -->|"read-only mount"| SKILLS
    MEM -->|"MCP operations"| MEMORY
    WASSETTE -->|"MCP over stdio"| WASSETTE_RUNTIME
    WASSETTE_RUNTIME -->|"network and environment capabilities"| GITHUB

    classDef component fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class CONFIG,LIFECYCLE,VM,MEM,WASSETTE,POLICY,REGISTRY component;
    class WORKER,GITHUB,WASSETTE_RUNTIME external;
    class WORKSPACE,SKILLS,MEMORY data;
