flowchart LR
    %% C4 deployment view. Arrows show only trust-boundary crossings and operational dependencies.
    USER(["Person<br/><b>Voice Operator</b>"])
    TASK_USER(["Person<br/><b>Task Operator</b>"])
    CONTROL["External system<br/><b>Tailscale Control Plane</b>"]
    TELEGRAM_API["External system<br/><b>Telegram Bot API</b>"]
    MODELS["External system<br/><b>Model Providers</b>"]
    EXTERNAL["External system<br/><b>Optional Integrations</b>"]

    subgraph DEVICE["User device · Safari or WebRTC browser"]
        BROWSER["Container<br/><b>Browser Client</b><br/>React · Pipecat RTVI"]
    end

    subgraph MAC["Apple Silicon Mac · macOS"]
        direction LR

        subgraph DOCKER["Docker Desktop Linux VM · Docker Compose"]
            direction TB
            subgraph EDGE_NS["Shared Tailscale network namespace"]
                direction LR
                INGRESS["Container<br/><b>Tailnet Ingress</b><br/>Tailscale Serve"]
                EDGE["Container<br/><b>Voice Edge</b><br/>Pipecat · read-only · non-root"]
                INGRESS -->|"voice UI proxy :443"| EDGE
            end
            GATEWAY["Container<br/><b>Agent Gateway</b><br/>read-only · non-root"]
            TELEGRAM["Container<br/><b>Task Telegram Adapter</b><br/>long polling · read-only · non-root"]
            POSTGRES[("Container database<br/><b>PostgreSQL</b><br/>proposals · Absurd queue · checkpoints")]
            S3[("Container data store<br/><b>S3Mock</b><br/>immutable workspaces · bounded results")]
            OTEL["Container<br/><b>OTel LGTM</b><br/>metrics · traces · no logs"]
            GATEWAY -->|"private SQL"| POSTGRES
            GATEWAY -->|"private S3 API"| S3
            TELEGRAM -->|"scoped bearer HTTP"| GATEWAY
        end

        subgraph NATIVE["Native macOS services · launchd · loopback only"]
            direction TB
            BROKER["Container<br/><b>Inference Broker</b><br/>FastAPI · MLX Whisper · MLX Kokoro"]
            PI["Container<br/><b>Pi Voice Service</b><br/>Node.js · persistent Pi session"]
            WORKER["Container<br/><b>Pi Task Worker</b><br/>Python · concurrency one"]
            RUNTIME[("Private data store<br/><b>Runtime Data</b><br/>copied runtimes · secrets · sessions · scratch")]
            BROKER -->|"bearer HTTP :9446"| PI
            PI -->|"sessions · workspace · skills"| RUNTIME
            WORKER -->|"scratch · copied runtime"| RUNTIME
        end

        subgraph ISOLATION["Agent tool isolation"]
            direction TB
            VOICE_VM["Container<br/><b>Persistent Voice VM</b><br/>Gondolin · workspace RW · skills RO"]
            TASK_VM["Container<br/><b>Per-task VM</b><br/>Gondolin · one workspace"]
            WASSETTE["Container<br/><b>Integration Runtime</b><br/>Wassette · declared permissions"]
            TASK_VM -->|"MCP"| WASSETTE
        end

        EDGE -->|"bearer HTTP via host gateway :9443"| BROKER
        EDGE -->|"control network :9444"| GATEWAY
        PI -->|"loopback :9444"| GATEWAY
        WORKER -->|"loopback :54329"| POSTGRES
        WORKER -->|"loopback :9090"| S3
        PI -->|"native tools"| VOICE_VM
        WORKER -->|"Pi extension"| TASK_VM
        EDGE -.->|"OTLP/HTTP"| OTEL
        GATEWAY -.->|"OTLP/HTTP"| OTEL
        TELEGRAM -.->|"OTLP/HTTP"| OTEL
        BROKER -.->|"loopback OTLP/HTTP"| OTEL
        INGRESS -->|"owner identity header · Grafana :8443"| OTEL
    end

    USER -->|"talk · listen · review"| BROWSER
    TASK_USER -->|"create · approve · inspect · cancel"| TELEGRAM_API
    TELEGRAM -->|"outbound HTTPS only"| TELEGRAM_API
    BROWSER -->|"tailnet HTTPS :443/:8443 · WebRTC"| INGRESS
    INGRESS -.->|"control protocol"| CONTROL
    PI -->|"host-held credentials"| MODELS
    WORKER -->|"host-held credentials"| MODELS
    WASSETTE -->|"permission-scoped HTTPS"| EXTERNAL

    classDef person fill:#084c8d,color:#fff,stroke:#05345f,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef container fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef security fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class USER,TASK_USER person;
    class CONTROL,TELEGRAM_API,MODELS,EXTERNAL external;
    class BROWSER,TELEGRAM,BROKER,PI,WORKER,VOICE_VM,TASK_VM,WASSETTE,OTEL container;
    class INGRESS,EDGE,GATEWAY security;
    class POSTGRES,S3,RUNTIME data;
