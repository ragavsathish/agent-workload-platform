flowchart LR
    %% C4 deployment view. Only boundary crossings and primary runtime relationships are shown.
    USER(["Person<br/><b>Tailnet User</b>"])

    subgraph DEVICE["User device"]
        BROWSER["Browser Client<br/>Flutter Web · Pipecat transport"]
    end

    subgraph MAC["Apple Silicon Mac · one macOS user boundary"]
        direction LR

        subgraph DOCKER["Docker Desktop Linux VM"]
            direction TB
            subgraph TRUST_NS["Shared namespace · 172.30.90.2 · trusted proxy source IP"]
                direction TB
                INGRESS["Tailscale Serve<br/>tailnet HTTPS"]
                ROUTER["Traefik<br/>owner forward-auth"]
                EDGE["Voice Edge<br/>Pipecat · read-only · non-root"]
                TRUST_RISK["Risk<br/>Edge shares Grafana's trusted proxy source IP"]
                INGRESS -->|"identity header"| ROUTER
                ROUTER -->|"/ · WebRTC"| EDGE
                EDGE -.-> TRUST_RISK
            end

            subgraph CONTROL_NET["control · non-internal"]
                GATEWAY["Agent Gateway<br/>identity · commands"]
                HABITAT["Absurd Habitat<br/>queue operations"]
            end

            subgraph DATA_NET["data · internal"]
                POSTGRES[("PostgreSQL<br/>proposals · queue · checkpoints")]
                S3[("S3Mock<br/>workspaces · results")]
                GITEA[("Gitea<br/>Git · Actions · workflow state")]
                DOCKER_JOB_API["Docker Job API<br/>Go · authenticated jobs"]
                HOST_DOCKER["Host Docker Engine<br/>Engine API · socket protected"]
                OXIGRAPH[("Oxigraph<br/>loopback SPARQL · persistent RDF")]
            end

            subgraph MONITOR_NET["monitoring · internal"]
                DOCKER_METRICS["Docker VM Metrics<br/>Fluent Bit"]
                OTEL["OTel LGTM<br/>Prometheus · Tempo · Grafana"]
                GRAFANA_MCP["Grafana MCP<br/>read-only · caller bearer · MCP Apps"]
                DOCKER_METRICS --> OTEL
                GRAFANA_MCP -->|"service-account API<br/>PromQL · TraceQL"| OTEL
                GRAFANA_MCP -.->|"metrics · OTLP traces"| OTEL
            end

            EDGE -->|"task API"| GATEWAY
            EDGE -->|"identity-checked App and trace proxy"| GRAFANA_MCP
            GATEWAY --> POSTGRES
            GATEWAY --> S3
            GATEWAY -->|"fixed read-only SPARQL"| OXIGRAPH
            HABITAT -->|"scoped queue SQL"| POSTGRES
            ROUTER -->|"/queue/"| HABITAT
            ROUTER -->|"/git/"| GITEA
            ROUTER -->|"/metrics/"| OTEL
            EDGE -.->|"OTLP"| OTEL
        end

        subgraph NATIVE["Native macOS · launchd and child processes"]
            direction TB
            BROKER["Inference Broker<br/>FastAPI · MLX STT/TTS"]
            PI["Pi Voice Service<br/>persistent Pi session"]
            WORKER["Pi Task Worker<br/>claim · execute · checkpoint"]
            TASK_PI["Pi Task Session<br/>bounded child process"]
            BUILDER_MANAGER["Builder VM Manager<br/>warm VM lifecycle"]
            IMAGE_HANDOFF[("Image Handoff<br/>versioned image tar files")]
            VOICE_WASSETTE["Voice Wassette MCP<br/>per-session child"]
            TASK_WASSETTE["Task Wassette MCP<br/>per-task child"]
            HOST_METRICS["Host Observability<br/>Mac + QEMU metrics"]
            RUNTIME[("Host-private data<br/>sessions · skills · scratch · secrets")]

            BROKER --> PI
            PI --> RUNTIME
            WORKER --> RUNTIME
            WORKER --> TASK_PI
            PI --> VOICE_WASSETTE
            TASK_PI --> TASK_WASSETTE
            PI -->|"bearer · loopback streamable HTTP"| GRAFANA_MCP
        end

        subgraph VMS["Gondolin micro-VM isolation"]
            direction TB
            subgraph VOICE_VM["Persistent voice VM · no public egress"]
                VOICE_TOOLS["Voice tools<br/>workspace RW · Git · Tea · AWS CLI"]
            end
            subgraph TASK_VM["Per-task VM · public egress enabled by current default"]
                TASK_TOOLS["Task tools<br/>isolated workspace · project policy"]
            end
            subgraph BUILDER_VM["Shared builder VM · trusted workflows"]
                RUNNER["Gitea Runner · Docker CLI/Compose"]
                CLIENT["Host Docker Job API client"]
                RUNNER --> CLIENT
            end
        end

        EDGE -->|"bearer · host-access"| BROKER
        VOICE_WASSETTE -->|"component-scoped bearers<br/>task and read-only knowledge tools"| GATEWAY
        PI -->|"native tools"| VOICE_TOOLS
        TASK_PI -->|"isolated tools"| TASK_TOOLS
        BUILDER_MANAGER -->|"resume · checkpoint"| RUNNER
        VOICE_TOOLS -->|"synthetic allowlist"| GITEA
        VOICE_TOOLS -->|"synthetic allowlist"| S3
        VOICE_TOOLS -->|"raw SPARQL query/update<br/>loopback-published endpoint"| OXIGRAPH
        RUNNER -->|"Actions · checkout"| GITEA
        CLIENT -->|"authenticated context · job status"| DOCKER_JOB_API
        DOCKER_JOB_API -->|"Engine API over Docker socket"| HOST_DOCKER
        HOST_DOCKER -->|"versioned image tar"| IMAGE_HANDOFF
        RUNNER -.->|"OTLP job traces · runner metrics"| OTEL
        WORKER -->|"local image tar"| IMAGE_HANDOFF
        HOST_METRICS -.->|"host-access scrape"| OTEL
    end

    subgraph EXTERNAL["External systems"]
        direction TB
        CONTROL["Tailscale Control Plane"]
        MODELS["Model Providers"]
        INTERNET["Public Internet and Integrations"]
    end

    USER --> BROWSER -->|"tailnet HTTPS · WebRTC"| INGRESS
    INGRESS -.-> CONTROL
    PI -->|"host-held credential"| MODELS
    TASK_PI -->|"host-held credential"| MODELS
    VOICE_WASSETTE -->|"granted capability"| INTERNET
    TASK_WASSETTE -->|"granted capability"| INTERNET
    TASK_TOOLS -->|"current default"| INTERNET
    HOST_DOCKER -->|"base-image pulls and builds"| INTERNET

    classDef person fill:#084c8d,color:#fff,stroke:#05345f,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef runtime fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef security fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px;
    classDef warning fill:#3b2027,color:#ffd7de,stroke:#ff778a,stroke-width:3px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class USER person;
    class CONTROL,MODELS,INTERNET,HOST_DOCKER external;
    class BROWSER,BROKER,PI,WORKER,TASK_PI,BUILDER_MANAGER,VOICE_WASSETTE,TASK_WASSETTE,HOST_METRICS,VOICE_TOOLS,TASK_TOOLS,RUNNER,CLIENT,DOCKER_JOB_API,HABITAT,DOCKER_METRICS,OTEL,GRAFANA_MCP runtime;
    class INGRESS,ROUTER,EDGE,GATEWAY security;
    class TRUST_RISK warning;
    class POSTGRES,S3,GITEA,OXIGRAPH,RUNTIME,IMAGE_HANDOFF data;
