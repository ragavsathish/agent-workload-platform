package diagram:c4-pipeline@0.1.0;

/// Shared values crossing the compiler, graph-layout, fallback renderer, and
/// Excalidraw-policy seams.
interface types {
    enum direction {
        automatic,
        top-to-bottom,
        left-to-right,
    }

    enum theme {
        light,
        dark,
    }

    enum c4-kind {
        person,
        external-person,
        software-system,
        external-software-system,
        container,
        component,
        database,
        queue,
        boundary,
    }

    enum error-code {
        invalid-source,
        unsupported-syntax,
        input-limit-exceeded,
        layout-failed,
        invalid-layout,
        invalid-scene,
        policy-rejected,
        internal-error,
    }

    record pipeline-error {
        code: error-code,
        message: string,
        details: option<string>,
    }

    record point {
        x: f64,
        y: f64,
    }

    record bounds {
        x: f64,
        y: f64,
        width: f64,
        height: f64,
    }

    record computed-style {
        fill: option<string>,
        stroke: option<string>,
        stroke-width: option<f64>,
        stroke-dasharray: option<string>,
        color: option<string>,
        font-family: option<string>,
        font-size: option<f64>,
        font-weight: option<string>,
    }

    record layout-node {
        id: string,
        shape: string,
        bounds: bounds,
        style: computed-style,
    }

    record layout-edge {
        id: string,
        source-id: string,
        target-id: string,
        points: list<point>,
        style: computed-style,
    }

    record layout-text {
        id: string,
        text: string,
        bounds: bounds,
        style: computed-style,
    }

    /// Browser-derived geometry only. It intentionally contains no Excalidraw
    /// elements so scene construction remains inside the Wasm compiler.
    record layout-snapshot {
        width: f64,
        height: f64,
        nodes: list<layout-node>,
        edges: list<layout-edge>,
        texts: list<layout-text>,
        renderer: string,
        warnings: list<string>,
    }

    record browser-render-request {
        mermaid: string,
        configuration-json: string,
        maximum-output-bytes: u32,
    }

    /// A C4 element prepared by the compiler. Parent IDs flatten C4 nesting so
    /// the value crosses the Canonical ABI without recursive records.
    record graph-node {
        id: string,
        parent-id: string,
        kind: c4-kind,
        label: string,
    }

    record graph-edge {
        id: string,
        source-id: string,
        target-id: string,
        label: string,
    }

    /// Browserless input for a deterministic C4 layout implementation.
    record graph-layout-request {
        title: option<string>,
        direction: direction,
        theme: theme,
        maximum-elements: u32,
        nodes: list<graph-node>,
        edges: list<graph-edge>,
    }

    record compile-options {
        direction: direction,
        theme: theme,
        maximum-source-bytes: u32,
        maximum-elements: u32,
    }

    record compile-request {
        source: string,
        options: compile-options,
    }

    /// The versioned JSON envelope avoids coupling WIT releases to every
    /// Excalidraw element-field addition while keeping the outer contract typed.
    record scene-envelope {
        format: string,
        format-version: u32,
        elements-json: string,
        files-json: string,
    }

    record compiled-scene {
        scene: scene-envelope,
        warnings: list<string>,
    }

    /// Opaque, versioned compiler state returned by prepare and consumed by
    /// finish. Callers must not inspect or modify it.
    record prepared-compilation {
        state: list<u8>,
        layout-request: graph-layout-request,
        render-request: browser-render-request,
    }

    record admission-policy {
        maximum-scene-bytes: u32,
        maximum-elements: u32,
        allow-external-urls: bool,
        allow-embedded-files: bool,
    }

    record approved-scene {
        scene: scene-envelope,
        warnings: list<string>,
    }
}

/// Browserless layout port. Implementations receive a typed C4 graph and may
/// not parse Mermaid or access the filesystem, network, process, or browser.
interface graph-layout {
    use types.{graph-layout-request, layout-snapshot, pipeline-error};

    layout: func(request: graph-layout-request) -> result<layout-snapshot, pipeline-error>;
}

/// Preferred deep compiler interface. Layout is hidden behind graph-layout.
interface compiler {
    use types.{compile-request, compiled-scene, pipeline-error};

    compile: func(request: compile-request) -> result<compiled-scene, pipeline-error>;
}

/// Compatibility interface for the optional Gondolin fallback. The host calls
/// prepare, invokes the adapter, then passes the unchanged state and returned
/// snapshot to finish.
interface compiler-core {
    use types.{
        compile-request,
        compiled-scene,
        layout-snapshot,
        pipeline-error,
        prepared-compilation,
    };

    prepare: func(request: compile-request) -> result<prepared-compilation, pipeline-error>;
    finish: func(
        state: list<u8>,
        layout: layout-snapshot,
    ) -> result<compiled-scene, pipeline-error>;
}

/// Independent policy module that accepts compiler output and returns the only
/// scene that may be sent to a browser or checkpoint store.
interface excalidraw-policy {
    use types.{admission-policy, approved-scene, pipeline-error, scene-envelope};

    approve: func(
        scene: scene-envelope,
        policy: admission-policy,
    ) -> result<approved-scene, pipeline-error>;
}

/// Target composition: a browserless layout component satisfies graph-layout.
world c4-compiler {
    import graph-layout;
    export compiler;
}

/// Compatibility world used only when Pi explicitly selects the Gondolin
/// prepare/render/finish fallback.
world c4-compiler-core {
    export compiler-core;
}

world c4-layout-component {
    export graph-layout;
}

world excalidraw-policy-component {
    export excalidraw-policy;
}
