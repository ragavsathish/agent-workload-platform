C4Deployment
title Composable C4 to Excalidraw Pipeline - Deployment View

Person(author, "Diagram Author", "Requests, views, and edits C4 architecture diagrams")

Deployment_Node(client, "Client Machine", "User workstation", "Orchestrates diagram generation and presents the approved result") {
  Container(pi, "Pi Coordinator", "Process", "Applies the C4 skill and orchestrates model, Wassette, policy, checkpoint, and Excalidraw calls")

  Deployment_Node(wassette, "Wassette Runtime", "WebAssembly Component Runtime", "Runs capability-limited WIT modules") {
    Container(suite, "C4 Wasm Suite", "c4-suite.wasm", "Packages the single-runtime C4 engine with reusable policy and checkpoint blocks")
  }

  ContainerDb(checkpoints, "Checkpoint Store", "Host memory or LeoFS", "Stores approved Excalidraw scene revisions")
  Container(excalidraw, "Excalidraw Web App", "Browser application", "Displays and edits approved architecture diagrams")
}

Deployment_Node(gondolin, "Optional Gondolin QEMU Micro-VM", "Playwright OCI root filesystem", "Isolates the explicitly selected legacy browser fallback") {
  Container(browser_layout, "Browser Layout Adapter", "Node.js, Mermaid, Playwright, Chromium", "Returns typed geometry only on the fallback path")
}

Deployment_Node(ai_provider, "External AI Provider", "Remote model infrastructure", "Hosts the selected architecture model") {
  System_Ext(model, "GPT or Qwen", "Produces native C4 Mermaid from the architecture request")
}

Rel(author, pi, "Requests a C4 diagram", "Natural language")
Rel(pi, model, "Generates C4 Mermaid with", "Model API")
Rel(pi, suite, "Compiles, approves, and checkpoints", "MCP and WIT")
Rel(pi, browser_layout, "May request legacy layout", "C4_LAYOUT_BACKEND=gondolin")
Rel(suite, checkpoints, "Stores approved revision", "Excalidraw JSON")
Rel(suite, excalidraw, "Approves displayed and edited scenes", "Excalidraw JSON")
Rel(author, excalidraw, "Views and edits diagram", "Browser UI")
