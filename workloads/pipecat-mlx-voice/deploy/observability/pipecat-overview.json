{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "sum(rate(pipecat_operation_total[$__rate_interval])) by (service_name, app_operation, app_outcome)",
          "legendFormat": "{{service_name}} · {{app_operation}} · {{app_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Operation rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pipecat_operation_duration_seconds_bucket[$__rate_interval])) by (le, service_name, app_operation))",
          "legendFormat": "{{service_name}} · {{app_operation}}",
          "refId": "A"
        }
      ],
      "title": "Operation latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto"},
      "targets": [
        {
          "expr": "sum(pipecat_operation_total)",
          "legendFormat": "operations",
          "refId": "A"
        }
      ],
      "title": "Observed operations",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto"},
      "targets": [
        {
          "expr": "sum(pipecat_operation_total{app_outcome=\"error\"})",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "title": "Operation errors",
      "type": "stat"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "options": {"showHeader": true},
      "targets": [
        {
          "limit": 20,
          "query": "{ resource.service.namespace = \"pipecat-mlx-voice\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Recent payload-free traces",
      "type": "table"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["pipecat", "voice", "otel"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "Pipecat Voice Overview",
  "uid": "pipecat-voice-overview",
  "version": 1
}
