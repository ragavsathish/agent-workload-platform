[Unit]
Description=Unprivileged Pipecat browser and voice edge
Requires=pipecat-edge-pod.service
After=pipecat-edge-pod.service

[Container]
Image=__PIPECAT_EDGE_IMAGE__
Pull=never
ContainerName=pipecat-edge-app
Pod=pipecat-edge.pod
EnvironmentFile=%h/.config/pipecat-edge/edge.env
Secret=pipecat-broker-token,type=mount,target=broker-token
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
User=65532:65532
Notify=healthy
Tmpfs=/tmp:rw,noexec,nosuid,nodev
PodmanArgs=--pids-limit=256 --memory=2g --cpus=2

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
