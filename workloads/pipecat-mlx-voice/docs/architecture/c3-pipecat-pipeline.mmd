flowchart LR
    %% C4 component view: the Pipecat pipeline is inside the voice-edge container.
    subgraph P["Voice Edge container · Pipecat pipeline"]
        direction LR
        T["SmallWebRTCTransport<br/><small>browser audio transport</small>"]
        V["SileroVADAnalyzer<br/><small>speech boundaries</small>"]
        S["OpenAISTTService<br/><small>STT adapter</small>"]
        C["LLMContextAggregatorPair<br/><small>turn context</small>"]
        L["OpenAILLMService<br/><small>chat adapter</small>"]
        X["VoiceVisualResponseProcessor<br/><small>spoken + Mermaid split</small>"]
        Q["Task lifecycle functions<br/><small>propose · status · approve · cancel</small>"]
        A["OpenAITTSService<br/><small>TTS adapter</small>"]
        T -->|audio frames| V -->|speech boundaries| C
        T -->|audio frames| S -->|transcription frames| C
        C -->|user turn| L -->|model response| X -->|spoken field| A -->|audio frames| T
        L -. function calls .-> Q
    end

    B["Browser Client"]
    I["Inference Broker<br/><small>MLX Whisper · Ollama · MLX/Kokoro</small>"]
    G["Agent Gateway<br/><small>identity-bound task API</small>"]

    B -->|WebRTC audio + UI events| T
    X -->|Mermaid event| B
    S -. authenticated STT .-> I
    L -. authenticated chat .-> I
    A -. authenticated TTS .-> I
    Q -. bearer task commands .-> G

    classDef pipecat fill:#dbeafe,stroke:#2563eb,color:#0f172a;
    classDef app fill:#dcfce7,stroke:#16a34a,color:#14532d;
    classDef external fill:#f3f4f6,stroke:#6b7280,color:#111827;
    class T,V,S,C,L,A pipecat;
    class X,Q app;
    class B,I,G external;
