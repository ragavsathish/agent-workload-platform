C4Deployment
title Pipecat MLX Voice - Deployment and Security Boundaries

Person(user, "Tailnet User", "Uses an approved identity")
System_Ext(tailscale_control, "Tailscale Control Plane", "Authenticates tailnet devices")
System_Ext(ollama, "Ollama", "Runs the approved chat model")

Deployment_Node(phone, "User Device") {
  Container(browser, "Browser Client", "Safari and React", "Captures and plays audio")
}

Deployment_Node(mac, "Apple Silicon Mac") {
  Container(broker, "Inference Broker", "FastAPI on 127.0.0.1:9443", "Bounded STT, TTS, and chat API")
  Container(tunnel, "Inference Tunnel", "OpenSSH LaunchAgent", "Host-initiated reverse port forward")

  Deployment_Node(vm, "pipecat-edge libkrun Micro-VM") {
    Deployment_Node(user_systemd, "Rootless systemd and Quadlet") {
      Container(ingress, "Tailnet Ingress", "Tailscale userspace", "Private HTTPS without TUN or NET_ADMIN")
      Container(edge, "Voice Edge", "Pipecat as UID 65532", "Read-only and capability-free")
    }
  }
}

Rel(user, browser, "Talks through", "Microphone and speaker")
Rel(browser, ingress, "Streams audio", "Tailnet HTTPS and WebSocket")
Rel(ingress, tailscale_control, "Obtains verified identity from", "Tailscale control protocol")
Rel(ingress, edge, "Proxies identity and voice traffic", "VM network namespace")
Rel(edge, tunnel, "Calls the scoped inference API", "VM loopback port 9443")
Rel(tunnel, broker, "Forwards only broker port 9443", "Reverse SSH")
Rel(broker, ollama, "Requests exact-model chat", "Mac loopback port 11434")
