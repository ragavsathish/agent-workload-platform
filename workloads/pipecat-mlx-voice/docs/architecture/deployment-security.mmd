flowchart TB
    %% C4 deployment view: private voice ingress and isolated agent tools.
    USER(["Person<br/><b>Tailnet User</b><br/>talks, listens, explicitly approves"])
    CONTROL["External system<br/><b>Tailscale Control Plane</b><br/>device and network authority"]

    subgraph DEVICE["User device"]
        BROWSER["Container<br/><b>Browser Client</b><br/>Safari · React · microphone · speaker"]
    end

    subgraph MAC["Apple Silicon Mac"]
        direction LR
        subgraph DOCKER["Docker Desktop Linux VM"]
            direction TB
            subgraph COMPOSE["Docker Compose · container services"]
                direction TB
                INGRESS["Container<br/><b>Tailnet Ingress</b><br/>Tailscale Serve · trusted HTTPS"]
                EDGE["Container<br/><b>Voice Edge</b><br/>exact origin · one-use path token"]
                GATEWAY["Container<br/><b>Agent Gateway</b><br/>four identity-scoped task routes"]
                DB[("Container database<br/><b>Postgres + Absurd</b><br/>durable proposals · tasks · checkpoints")]
                INGRESS -->|"authenticated HTTP + WebSocket · shared loopback"| EDGE
                EDGE -->|"gateway bearer · control network"| GATEWAY
                GATEWAY -->|"internal data network"| DB
            end
        end

        subgraph NATIVE["Native macOS services · one LaunchAgent supervisor"]
            direction TB
            SUPERVISOR["Host process<br/><b>Host Service Supervisor</b><br/>macOS LaunchAgent"]
            BROKER["Host process<br/><b>Inference Broker</b><br/>MLX Whisper · Ollama · MLX Kokoro"]
            PIVOICE["Host process<br/><b>Native Pi Voice</b><br/>Pi + Gondolin extension"]
            WORKER["Host process<br/><b>Pi Worker</b><br/>one durable Pi session per task"]
            GONDOLIN["Micro-VM<br/><b>Gondolin</b><br/>isolated browser + workspace tools"]
            WASSETTE["Wasm runtime<br/><b>Wassette</b><br/>permission-scoped MCP components"]
            SUPERVISOR --> BROKER
            SUPERVISOR --> PIVOICE
            SUPERVISOR --> WORKER
            WORKER -->|"isolated browser + workspace tools"| GONDOLIN
            WORKER -->|"scoped integration tools"| WASSETTE
            PIVOICE -->|"Pi tool calls"| GONDOLIN
        end

        EDGE -->|"broker bearer · host.docker.internal:9443"| BROKER
        DB <-->|"loopback 127.0.0.1:54329"| WORKER
    end

    USER -->|"microphone + speaker"| BROWSER
    BROWSER -->|"tailnet HTTPS + WebSocket"| INGRESS
    INGRESS -.->|"control protocol"| CONTROL

    classDef person fill:#084c8d,color:#fff,stroke:#05345f,stroke-width:2px;
    classDef external fill:#6b7280,color:#fff,stroke:#374151,stroke-width:2px;
    classDef container fill:#e0f2fe,color:#0c4a6e,stroke:#0284c7,stroke-width:2px;
    classDef security fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px;
    classDef data fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px;
    class USER person;
    class CONTROL external;
    class BROWSER,BROKER,WORKER,GONDOLIN,WASSETTE container;
    class INGRESS,EDGE,GATEWAY security;
    class DB data;
