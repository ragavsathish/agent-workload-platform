PIPECAT_WEBSOCKET_AUTH=token
PIPECAT_ALLOWED_ORIGINS=https://pipecat-edge.example-tailnet.ts.net
EDGE_ALLOWED_USERS=you@example.com

# This is only an inference capability. It cannot access files, tasks, or credentials.
INFERENCE_BROKER_TOKEN_FILE=/run/secrets/broker-token
INFERENCE_BROKER_BASE_URL=http://host.docker.internal:9443/v1
AGENT_GATEWAY_TOKEN_FILE=/run/secrets/agent-gateway-token
AGENT_GATEWAY_BASE_URL=http://agent-gateway:9444/v1
OLLAMA_MODEL=qwen3.5:9b-mlx
