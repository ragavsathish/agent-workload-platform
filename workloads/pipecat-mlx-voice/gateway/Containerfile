FROM ghcr.io/astral-sh/uv@sha256:88bc6eb1ccd4b82efd0e1b530caffabddf50dc2bf612e66c14ea25b8ee8a4d3d AS uv
FROM docker.io/library/python@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

LABEL io.pipecat.agent-gateway="true"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=uv /uv /usr/local/bin/uv
RUN groupadd --gid 65532 app && useradd --uid 65532 --gid 65532 --no-create-home app

WORKDIR /app
COPY gateway/pyproject.toml gateway/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY server/agent_gateway.py ./
COPY server/telemetry.py ./
COPY server/orchestrator ./orchestrator

USER 65532:65532
EXPOSE 9444
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=12 \
    CMD ["/app/.venv/bin/python", "-c", "import pathlib,urllib.request; t=pathlib.Path('/run/secrets/agent-gateway-token').read_text().strip(); r=urllib.request.Request('http://127.0.0.1:9444/health', headers={'Authorization':'Bearer '+t}); urllib.request.urlopen(r, timeout=3).read()"]
ENTRYPOINT ["/app/.venv/bin/python", "agent_gateway.py"]
